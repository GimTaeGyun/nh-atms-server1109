# =====================================================================
# Jenkins 컨테이너 환경변수 — ws01 ~/atms/infra/jenkins/jenkins.env (600)
#   deploy/jenkins/run-jenkins.sh 가 없으면 이 파일을 복사해 만든다 → CHANGE_ME 를 바꾼 뒤 다시 실행
#   podman --env-file 형식: 따옴표 없이, 값에 공백 가능. 비밀번호에 ' 는 쓰지 않는다
#   관리자 계정은 이미지 안 JCasC(casc/jenkins.yaml)가 첫 기동 때 이 값으로 만든다
# =====================================================================
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=CHANGE_ME
JENKINS_URL=http://16.88.122.113:8090/
# 이미지 기본값(설정 마법사 끔, UTF-8) + 힙 1GB (2코어·JEUS 공존)
JAVA_OPTS=-Djenkins.install.runSetupWizard=false -Dfile.encoding=UTF-8 -Xmx1g
# offline-seed 캐시 (DEV_SERVER_SETUP 9-5): run-jenkins.sh 가 ~/atms/infra/jenkins/cache/{gradle,npm} 를 마운트
GRADLE_USER_HOME=/cache/gradle
npm_config_cache=/cache/npm
TZ=Asia/Seoul
