# =====================================================================
# ~/deploy/deploy-war.env (600) — deploy/jeus/deploy-war.sh 가 읽는 서버 설정
#   install-deploy-war.sh 가 없을 때만 이 파일을 복사해 만든다 (이미 있으면 건드리지 않음)
#   bash 로 읽으므로 "이름=값" 형식, = 앞뒤 공백 없이
#
# 구성 (2026-10-26): JEUS 도메인 1개 + 매니지드 서버 6개, 컨텍스트 '/'
#   키      모듈              서버                    포트
#   web     atms-web          atms01     8080
#   journal atms-journal      ajou01    8081
#   batch   atms-batch        abat01      8082
#   file    atms-file         file01       8083
#   ifin    atms-if-internal  ifin01       8084
#   ifex    atms-if-external  ifex01       8085
#   아래 주석(#) 줄은 스크립트 기본값 — WAS 담당 회신이 다르면 주석을 풀고 바꾼다
# =====================================================================

# 서버 주소 (리스너가 LISTEN 하는 IP — 127.0.0.1 은 안 됨, 2026-10-23)
#JEUS_HOST=16.88.122.113

# 포트 (base 리스너 = HTTP 리스너)
#PORT_web=8080
#PORT_journal=8081
#PORT_batch=8082
#PORT_file=8083
#PORT_ifin=8084
#PORT_ifex=8085

# 서버 이름 (로그·status 표시용. WAS 담당이 정한 실제 이름으로)
#SERVER_web=atms01
#SERVER_journal=ajou01
#SERVER_batch=abat01
#SERVER_file=file01
#SERVER_ifin=ifin01
#SERVER_ifex=ifex01

# 재기동 메뉴 번호 (/JEUS/jeusATMS/jeusMENU/jeusRstart, jeusmenu.c 로 확인)
#   새 서버 6개(atms01~ifex01) 메뉴는 WAS 담당 회신값 — 예전 5·6 은 nbatmsltws01_atms01 용이라 쓰지 않음
#   비어 있으면 그 모듈은 재기동하지 않음 → "WAS 담당 재기동 필요" (Jenkins UNSTABLE)
#   3·7·8 은 스크립트가 거부 (3 = jeusatms java 전부 kill, 7·8 = WebtoB)
STOP_MENU_web=
BOOT_MENU_web=
STOP_MENU_journal=
BOOT_MENU_journal=
STOP_MENU_batch=
BOOT_MENU_batch=
STOP_MENU_file=
BOOT_MENU_file=
STOP_MENU_ifin=
BOOT_MENU_ifin=
STOP_MENU_ifex=
BOOT_MENU_ifex=

# 대기 시간(초)
#STOP_WAIT=180
#BOOT_WAIT=600

# 기동 확인에서 뺄 모듈 (예: DB 준비 전 atms-batch). 여러 개는 공백으로: "atms-batch atms-file"
HEALTH_SKIP=""
