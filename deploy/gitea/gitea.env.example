# =====================================================================
# Gitea 설정 (환경변수 → 컨테이너 기동 시 /etc/gitea/app.ini 로 자동 반영)
#  - 서버에서: install-gitea.sh 가 ~/atms/infra/gitea/gitea.env 로 복사 (600)
#  - 서버 IP(자리표시값), SECRET_KEY, INTERNAL_TOKEN 은 install-gitea.sh 가 채움 (IP 변경 시 이 파일 직접 수정)
#  - 값에 따옴표를 쓰지 않는다 (podman env-file 형식)
# =====================================================================

# 접속 주소 (HTTP 전용, SSH 끔)
GITEA__server__DOMAIN=CHANGE_SERVER_IP
GITEA__server__ROOT_URL=http://CHANGE_SERVER_IP:3000/
GITEA__server__HTTP_PORT=3000
GITEA__server__DISABLE_SSH=true
GITEA__server__START_SSH_SERVER=false
# 폐쇄망: 외부 CDN·아바타·업데이트 확인 사용 안 함
GITEA__server__OFFLINE_MODE=true
GITEA__picture__DISABLE_GRAVATAR=true
GITEA__picture__ENABLE_FEDERATED_AVATAR=false
GITEA__cron_0X2E_update_checker__ENABLED=false
GITEA__mailer__ENABLED=false

# DB: 내장 SQLite (별도 DB 서버 불필요, 2~5명 규모에 충분)
GITEA__database__DB_TYPE=sqlite3

# 설치 마법사 생략 (관리자는 install 후 명령으로 생성)
GITEA__security__INSTALL_LOCK=true
GITEA__security__SECRET_KEY=
GITEA__security__INTERNAL_TOKEN=

# 계정·저장소 정책: 가입 차단, 로그인해야 보임, 저장소 기본 비공개
GITEA__service__DISABLE_REGISTRATION=true
GITEA__service__REQUIRE_SIGNIN_VIEW=true
GITEA__service__DEFAULT_KEEP_EMAIL_PRIVATE=true
GITEA__repository__DEFAULT_PRIVATE=private
GITEA__repository__DEFAULT_BRANCH=main

# 웹훅을 보낼 수 있는 주소 목록. 웹훅은 같은 podman 네트워크(atms-net)의 http://atms-jenkins:8080 으로 보낸다
# → 그 주소는 사설 IP(10.89.x)라 private 그대로 둔다 (서버 IP 16.88.x 는 private 에 포함 안 됨, 쓰지 않음)
GITEA__webhook__ALLOWED_HOST_LIST=private

GITEA__time__DEFAULT_UI_LOCATION=Asia/Seoul
GITEA__log__LEVEL=Info
