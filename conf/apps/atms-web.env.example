# =====================================================================
# 앱별 설정: 파일명(atms-web) = 앱 이름 = 컨테이너 이름 = 이미지 이름
#  - 다른 모듈 추가 시 복사: conf/apps/atms-batch.env.example 등
#  - 서버에서: cp conf/apps/atms-web.env.example conf/apps/atms-web.env
# =====================================================================

# 포트 (1024 이상만 가능 / 사용중 포트 6600,6700,6800 회피 / 앱마다 다르게)
HOST_PORT=8080
CONTAINER_PORT=8080

# 헬스체크 URL 경로 (actuator 미사용 시 실제 존재하는 URL 로 변경)
HEALTH_PATH=/actuator/health

# 자원 제한 (서버 2 core / 31G, JEUS 와 공존 -> 앱 합계 CPU 1.5 이내 권장)
CPU_LIMIT=1.0
MEM_LIMIT=2g
