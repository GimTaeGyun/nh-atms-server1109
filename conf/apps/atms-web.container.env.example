# =====================================================================
# 컨테이너 내부 환경변수 (podman --env-file / 직접실행 모드에서도 사용)
#  - 서버에서: cp conf/apps/atms-web.container.env.example conf/apps/atms-web.container.env
#  - 비밀번호 등 민감정보는 config/<앱>/application-dev.yml 에 작성
# =====================================================================
TZ=Asia/Seoul
LANG=C.UTF-8
SPRING_PROFILES_ACTIVE=dev
JAVA_OPTS=-XX:MaxRAMPercentage=75.0 -XX:+UseG1GC -XX:ActiveProcessorCount=1 -Dfile.encoding=UTF-8 -Duser.timezone=Asia/Seoul
