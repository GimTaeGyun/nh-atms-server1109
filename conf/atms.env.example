# =====================================================================
# ATMS 배포킷 공통 설정 (모든 앱 공통)
#  - 서버에서: bin/init-dirs.sh 실행 시 conf/atms.env 로 자동 복사됨
#  - 실제 값 파일(conf/atms.env)은 Git 제외
# =====================================================================

# 배포킷 설치 경로 (logs/config/release/build/images/jdk 가 이 아래 생성됨)
BASE_DIR=/home/atmswas/atms

# 컨테이너 베이스 이미지 (podman images 로 확인한 정확한 이름:태그)
#  - JRE 이미지 반입 시 : docker.io/library/eclipse-temurin:21-jre-jammy (NH-ATMS 모듈 Dockerfile 과 동일)
#  - OS 이미지만 있으면  : DOCKERFILE=Dockerfile.jdk-local, BASE_IMAGE=<OS 이미지>
BASE_IMAGE=docker.io/library/eclipse-temurin:21-jre-jammy
DOCKERFILE=Dockerfile

# 헬스체크 최대 대기(초)
HEALTH_TIMEOUT_SEC=180

# 앱별 보관할 과거 이미지 개수 (current/previous 제외)
KEEP_IMAGES=3
