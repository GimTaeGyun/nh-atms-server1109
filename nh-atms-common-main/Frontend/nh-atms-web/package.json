{
  "name": "nh-atms-web",
  "private": true,
  "version": "1.0.0",
  "description": "NH-ATMS 공통 뼈대 + 견본 — 프론트엔드 (nh-atms 프론트와 같은 버전·구조)",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "vite --host",
    "dev:mock": "vite --host --mode mock",
    "build": "tsc -b && vite build",
    "build:mock": "tsc -b && vite build --mode mock",
    "preview": "vite preview --host --port 4173",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:shots": "playwright test e2e/screenshots.spec.ts",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "@ant-design/icons": "6.1.0",
    "@tanstack/react-query": "5.90.21",
    "antd": "6.3.1",
    "axios": "1.13.6",
    "dayjs": "1.11.19",
    "node-forge": "1.4.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-router-dom": "7.13.1",
    "xlsx": "0.18.5",
    "zustand": "5.0.11"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@playwright/test": "1.64.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.12.0",
    "@types/node-forge": "1.3.14",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.4",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.26",
    "globals": "16.5.0",
    "jsdom": "29.1.1",
    "msw": "2.15.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.56.1",
    "vite": "7.3.1",
    "vitest": "4.1.11"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
