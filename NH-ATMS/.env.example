# =====================================================================
# NH-ATMS docker-compose 환경변수 템플릿
#
# 사용법:
#   cp .env.example .env
#   .env 파일을 열어 실제 값으로 수정
#
# 주의:
#   .env 파일은 .gitignore로 커밋되지 않음 (민감 정보 포함)
#   .env.example 만 커밋 대상 (실제 값 없이 키 이름만 공유)
#
# ※ atm-simulator는 로컬 전용 운영으로 배포 환경변수에서 제외
# =====================================================================

# ── Spring 프로파일 ─────────────────────────────────────────────────
# dev | staging | prod
SPRING_PROFILES_ACTIVE=dev

# ── Oracle DB 접속 정보 ─────────────────────────────────────────────
# application.yml 의 ${SPRING_DATASOURCE_*} 플레이스홀더와 이름이 동일해야 함
# (과거 ORACLE_* 키를 사용했다면 아래 이름으로 교체할 것)
SPRING_DATASOURCE_URL=jdbc:oracle:thin:@//192.168.28.21:1521/ATMSPDB
SPRING_DATASOURCE_USERNAME=ATMS
SPRING_DATASOURCE_PASSWORD=

# ── CORS 허용 Origin ─────────────────────────────────────────────────
# 브라우저가 실제로 접속하는 URL (nginx 포트 포함)
# 여러 Origin은 쉼표로 구분: http://host1:port,http://host2:port
# [로컬] 미설정 시 localhost:3000, localhost:5173 자동 적용
# [서버] 실제 접속 URL 반드시 입력 → 미설정 시 로그인 403 발생
CORS_ALLOWED_ORIGINS=

# ── JWT 시크릿 ──────────────────────────────────────────────────────
# 운영에서는 256비트(32바이트) 이상의 랜덤 문자열로 반드시 교체
JWT_SECRET=

# ── atms-journal HMAC 서명 (ATM → 서버 요청 위변조 방지) ────────────
JOURNAL_HMAC_SECRET=
JOURNAL_HMAC_KEY_ID=default

# ── 포트 오버라이드 ──────────────────────────────────────────────────
# [로컬 개발] 기본값 사용 시 아래 항목 모두 주석 유지 (설정 불필요)
# FRONTEND_PORT=80
# ATMS_WEB_PORT=8080
# ATMS_JOURNAL_PORT=8081
# ATMS_BATCH_PORT=8082
# ATMS_FILE_PORT=8083
# ATMS_IF_INTERNAL_PORT=8084
# ATMS_IF_EXTERNAL_PORT=8085
#
# [서버 배포] 192.168.28.21 서버는 아래 포트가 이미 사용 중이므로 19xxx 대역 사용
#   충돌 포트: 80 (nginx), 8080 (halyk_api_ezcams), 8084 (globus_api_ezcams)
#   → 서버의 .env 에서 아래 값으로 설정
# FRONTEND_PORT=19080
# ATMS_WEB_PORT=19081
# ATMS_JOURNAL_PORT=19082
# ATMS_BATCH_PORT=19083
# ATMS_FILE_PORT=19084
# ATMS_IF_INTERNAL_PORT=19085
# ATMS_IF_EXTERNAL_PORT=19086
