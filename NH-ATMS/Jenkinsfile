// =====================================================================
// Jenkinsfile — NH-ATMS CI/CD Pipeline
//
// 트리거  : GitLab → Webhook → Jenkins (main 브랜치 push 시 자동 실행)
// 동작    : Jenkins가 GitLab에서 소스를 체크아웃한 뒤,
//           SSH로 배포 서버에 접속하여
//           git pull → docker compose build → docker compose up 실행
//
// 사전 등록 필요한 Jenkins Credentials (Manage Jenkins → Credentials):
//   gitlab-checkout-token : GitLab 저장소 체크아웃용 PAT
//                           (Kind: Username with password)
//   atms-server-ssh-key   : 배포 서버 SSH 접속용 개인 키
//                           (Kind: SSH Username with private key, Username: atec)
// =====================================================================

pipeline {

    // ── 에이전트 ──────────────────────────────────────────────────────
    agent any
    // Jenkins에 등록된 어느 에이전트에서든 실행 가능
    // 에이전트를 직접 지정하려면: agent { label 'build-server' }

    // ── 전역 옵션 ─────────────────────────────────────────────────────
    options {
        timeout(time: 30, unit: 'MINUTES')
        // 전체 파이프라인이 30분 이내에 완료되지 않으면 강제 실패
        // docker compose build 는 최초 실행 시 수 분 소요될 수 있음

        disableConcurrentBuilds()
        // 동시 빌드 방지: 이전 빌드가 끝나지 않으면 다음 빌드를 대기열에 유지
        // 배포 중 또 다른 배포가 겹쳐 서비스 불안정 상태가 되는 것을 방지

        buildDiscarder(logRotator(numToKeepStr: '10'))
        // 빌드 로그·아티팩트를 최근 10개만 보관 (디스크 절약)
    }

    // ── 환경변수 ──────────────────────────────────────────────────────
    environment {
        // ▼ 배포 대상 서버 정보 — 실제 환경에 맞게 수정
        DEPLOY_HOST = '192.168.28.21'       // 배포 서버 IP
        DEPLOY_USER = 'atec'                // SSH 접속 계정
        DEPLOY_DIR  = '/home/atec/nh-atms'       // 서버의 프로젝트 클론 경로
    }

    // ── 스테이지 ──────────────────────────────────────────────────────
    stages {

        // ── Stage 1 : Checkout ────────────────────────────────────────
        stage('Checkout') {
            steps {
                // Jenkins SCM 설정(Pipeline Job의 Definition)에 따라
                // GitLab 저장소에서 소스를 워크스페이스로 체크아웃
                checkout scm

                script {
                    // 짧은 커밋 해시를 환경변수로 저장 (로그·알림 용도)
                    env.GIT_COMMIT_SHORT = sh(
                        script: 'git rev-parse --short HEAD',
                        returnStdout: true
                    ).trim()
                }

                echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
                echo " 브랜치 : ${env.GIT_BRANCH}"
                echo " 커밋   : ${env.GIT_COMMIT_SHORT}"
                echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
            }
        }

        // ── Stage 2 : Deploy ─────────────────────────────────────────
        stage('Deploy') {
            steps {
                // sshagent: Jenkins Credentials에 등록된 SSH 개인 키를
                // 이 블록 내에서만 ssh-agent에 등록하여 사용
                // 블록을 벗어나면 자동으로 키 해제 (보안)
                sshagent(credentials: ['atms-server-ssh-key']) {
                    // agent에 로드된 키의 핑거프린트 확인
                    sh 'ssh-add -l'
                    sh """
                        ssh -o StrictHostKeyChecking=no \\
                            -o ConnectTimeout=10 \\
                            ${DEPLOY_USER}@${DEPLOY_HOST} '
                            export PATH=/usr/local/bin:/usr/bin:/bin:\$PATH
                            set -e

                            echo "===== [1/3] 소스 동기화 ====="
                            cd ${DEPLOY_DIR}
                            sudo chown -R ${DEPLOY_USER}:${DEPLOY_USER} ${DEPLOY_DIR}
                            git reset --hard HEAD
                            git pull origin main

                            echo "===== [2/3] Docker 빌드 ====="
                            docker compose build

                            echo "===== [3/3] 서비스 재시작 ====="
                            docker compose up -d --remove-orphans

                            echo "===== 배포 완료 ====="
                            docker compose ps
                        '
                    """
                }
            }
        }
    }

    // ── 빌드 후 처리 ──────────────────────────────────────────────────
    post {
        success {
            echo "✅ 배포 성공 | 커밋: ${env.GIT_COMMIT_SHORT}"
        }
        failure {
            echo "❌ 배포 실패 | Jenkins 콘솔 로그를 확인하세요"
        }
        always {
            // 빌드 워크스페이스 정리 (체크아웃된 소스 파일 삭제)
            // Jenkins 에이전트 디스크 낭비 방지
            cleanWs()
        }
    }
}
