# =====================================================================
# NH-ATMS Jenkins 환경변수 템플릿
#
# 사용법:
#   cd infra/jenkins
#   cp .env.example .env
#   .env 파일을 열어 실제 값 입력 후 저장
# =====================================================================

# ── Jenkins 관리자 계정 ─────────────────────────────────────────────
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=           # 8자 이상 복잡한 비밀번호 설정

# ── Jenkins 접속 정보 ───────────────────────────────────────────────
JENKINS_URL=http://localhost:8090/
JENKINS_ADMIN_EMAIL=admin@nh-atms.local

# ── 포트 (기본값 사용 시 주석 유지) ─────────────────────────────────
# JENKINS_HTTP_PORT=8090
# JENKINS_AGENT_PORT=50000

# ── GitLab OAuth (SSO 로그인용) ──────────────────────────────────────
# 발급 위치: http://192.168.28.21:8180/admin/applications
# Redirect URI: http://[Jenkins서버IP]:8090/securityRealm/finishLogin
GITLAB_CLIENT_ID=             # GitLab Application ID
GITLAB_CLIENT_SECRET=         # GitLab Application Secret
