<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="kr.co.nh.atms.web.sms.mapper.SmsMapper">

    <resultMap id="rm" type="kr.co.nh.atms.web.sms.entity.SmsSendData" autoMapping="true"/>

    <sql id="cols">
        SMS_SEQ, GLOBAL_ID, TERM_GROUP_ID, TERM_ID, RECV_PHONE, SEND_PHONE,
        MSG_CONTENT, ERR_CD, SEND_STATUS, SEND_DATE, SEND_TIME,
        RESULT_CD, RESULT_MSG, REG_DT
    </sql>

    <sql id="where">
        <where>
            <if test="termGroupId != null and termGroupId != ''">
                AND TERM_GROUP_ID = #{termGroupId}
            </if>
            <if test="recvPhone != null and recvPhone != ''">
                AND RECV_PHONE = #{recvPhone}
            </if>
            <if test="sendStatus != null and sendStatus != ''">
                AND SEND_STATUS = #{sendStatus}
            </if>
            <if test="fromDate != null and fromDate != ''">
                AND REG_DT &gt;= TO_TIMESTAMP(#{fromDate}, 'YYYYMMDD')
            </if>
            <if test="toDate != null and toDate != ''">
                AND REG_DT &lt; TO_TIMESTAMP(#{toDate}, 'YYYYMMDD') + 1
            </if>
        </where>
    </sql>

    <select id="selectList" resultMap="rm">
        SELECT <include refid="cols"/>
          FROM T_SMS_SEND_DATA
        <include refid="where"/>
        ORDER BY REG_DT DESC, SMS_SEQ DESC
        OFFSET #{offset} ROWS FETCH NEXT #{limit} ROWS ONLY
    </select>

    <select id="countList" resultType="long">
        SELECT COUNT(*) FROM T_SMS_SEND_DATA
        <include refid="where"/>
    </select>

    <select id="selectOne" resultMap="rm">
        SELECT <include refid="cols"/>
          FROM T_SMS_SEND_DATA
         WHERE SMS_SEQ = #{smsSeq}
    </select>

    <insert id="insert" parameterType="kr.co.nh.atms.web.sms.entity.SmsSendData"
            useGeneratedKeys="false" keyProperty="smsSeq">
        <selectKey keyProperty="smsSeq" resultType="long" order="BEFORE">
            SELECT SEQ_T_SMS_SEND_DATA.NEXTVAL FROM DUAL
        </selectKey>
        INSERT INTO T_SMS_SEND_DATA (
            SMS_SEQ, GLOBAL_ID, TERM_GROUP_ID, TERM_ID, RECV_PHONE, SEND_PHONE,
            MSG_CONTENT, ERR_CD, SEND_STATUS, REG_DT
        ) VALUES (
            #{smsSeq,jdbcType=NUMERIC},     #{globalId,jdbcType=VARCHAR},
            #{termGroupId,jdbcType=CHAR},   #{termId,jdbcType=VARCHAR},
            #{recvPhone,jdbcType=VARCHAR},  #{sendPhone,jdbcType=VARCHAR},
            #{msgContent,jdbcType=VARCHAR}, #{errCd,jdbcType=VARCHAR},
            'W',                            CURRENT_TIMESTAMP
        )
    </insert>

</mapper>
