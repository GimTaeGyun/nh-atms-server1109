<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="kr.co.nh.atms.web.atmmonitor.mapper.AtmMonitorMapper">

    <resultMap id="rm" type="kr.co.nh.atms.web.atmmonitor.entity.AtmMonitor" autoMapping="true"/>

    <sql id="cols">
        TERM_GROUP_ID, TERM_ID, JNL_DATE, JNL_TIME, AGENT_TYPE,
        ATM_STATUS, ERR_CD, ATM_ERR_CD, PROCESS_COUNT,
        MAN_STATUS, OMAN_STATUS, SPR_STATUS, JPR_STATUS, CHK_STATUS, CHA_STATUS,
        MCR_STATUS, PB_STATUS, RJT_STATUS,
        SEND_FLAG, RECV_DATE, RECV_TIME
    </sql>

    <sql id="where">
        <where>
            <if test="termGroupId != null and termGroupId != ''">
                AND TERM_GROUP_ID = #{termGroupId}
            </if>
            <if test="termId != null and termId != ''">
                AND TERM_ID = #{termId}
            </if>
            <if test="atmStatus != null and atmStatus != ''">
                AND ATM_STATUS = #{atmStatus}
            </if>
            <if test="errCd != null and errCd != ''">
                AND ERR_CD = #{errCd}
            </if>
            <if test="fromDate != null and fromDate != ''">
                AND JNL_DATE &gt;= #{fromDate}
            </if>
            <if test="toDate != null and toDate != ''">
                AND JNL_DATE &lt;= #{toDate}
            </if>
            <if test="errorOnly != null and errorOnly == true">
                AND ERR_CD IS NOT NULL
            </if>
        </where>
    </sql>

    <select id="selectList" resultMap="rm">
        SELECT <include refid="cols"/>
          FROM T_ATM_MONITOR
        <include refid="where"/>
        ORDER BY JNL_DATE DESC, JNL_TIME DESC
        OFFSET #{offset} ROWS FETCH NEXT #{limit} ROWS ONLY
    </select>

    <select id="countList" resultType="long">
        SELECT COUNT(*) FROM T_ATM_MONITOR
        <include refid="where"/>
    </select>

    <select id="selectOne" resultMap="rm">
        SELECT <include refid="cols"/>
          FROM T_ATM_MONITOR
         WHERE TERM_GROUP_ID = #{termGroupId}
           AND TERM_ID       = #{termId}
           AND JNL_DATE      = #{jnlDate}
           AND JNL_TIME      = #{jnlTime}
    </select>

    <insert id="insert" parameterType="kr.co.nh.atms.web.atmmonitor.entity.AtmMonitor">
        INSERT INTO T_ATM_MONITOR (
            <include refid="cols"/>
        ) VALUES (
            #{termGroupId,jdbcType=CHAR}, #{termId,jdbcType=VARCHAR},
            #{jnlDate,jdbcType=CHAR}, #{jnlTime,jdbcType=CHAR},
            #{agentType,jdbcType=CHAR},
            #{atmStatus,jdbcType=CHAR}, #{errCd,jdbcType=VARCHAR}, #{atmErrCd,jdbcType=VARCHAR},
            #{processCount,jdbcType=CHAR},
            #{manStatus,jdbcType=CHAR}, #{omanStatus,jdbcType=CHAR},
            #{sprStatus,jdbcType=CHAR}, #{jprStatus,jdbcType=CHAR},
            #{chkStatus,jdbcType=CHAR}, #{chaStatus,jdbcType=CHAR},
            #{mcrStatus,jdbcType=CHAR}, #{pbStatus,jdbcType=CHAR}, #{rjtStatus,jdbcType=CHAR},
            #{sendFlag,jdbcType=CHAR},
            #{recvDate,jdbcType=CHAR}, #{recvTime,jdbcType=CHAR}
        )
    </insert>

</mapper>
