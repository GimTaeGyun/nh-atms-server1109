<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="kr.co.nh.atms.web.agentstatus.mapper.AgentStatusMapper">

    <resultMap id="rm" type="kr.co.nh.atms.web.agentstatus.entity.AgentStatus" autoMapping="true"/>

    <sql id="cols">
        ATM_IP, AGENT_TYPE, TERM_GROUP_ID, TERM_ID, CONNECT_FLAG,
        AGENT_VER, AP_DOWN_VER, OS_NAME, ATM_MAC_ADDR, CONNECT_IP, CONNECT_PORT,
        JNL_MODE, POLL_CYCLE, START_DATE, START_TIME,
        LAST_POLL_DATE, LAST_POLL_TIME, EXIT_DATE, EXIT_TIME
    </sql>

    <sql id="where">
        <where>
            <if test="termGroupId != null and termGroupId != ''">
                AND TERM_GROUP_ID = #{termGroupId}
            </if>
            <if test="termId != null and termId != ''">
                AND TERM_ID = #{termId}
            </if>
            <if test="connectFlag != null and connectFlag != ''">
                AND CONNECT_FLAG = #{connectFlag}
            </if>
            <if test="fromDate != null and fromDate != ''">
                AND START_DATE &gt;= #{fromDate}
            </if>
            <if test="toDate != null and toDate != ''">
                AND START_DATE &lt;= #{toDate}
            </if>
        </where>
    </sql>

    <select id="selectList" resultMap="rm">
        SELECT <include refid="cols"/>
          FROM T_AGENT_STATUS
        <include refid="where"/>
        ORDER BY START_DATE DESC, START_TIME DESC, TERM_GROUP_ID, TERM_ID
        OFFSET #{offset} ROWS FETCH NEXT #{limit} ROWS ONLY
    </select>

    <select id="countList" resultType="long">
        SELECT COUNT(*) FROM T_AGENT_STATUS
        <include refid="where"/>
    </select>

    <select id="selectOne" resultMap="rm">
        SELECT <include refid="cols"/>
          FROM T_AGENT_STATUS
         WHERE ATM_IP = #{atmIp}
    </select>

    <select id="selectConnectedIp" resultType="string">
        SELECT ATM_IP FROM (
            SELECT ATM_IP
              FROM T_AGENT_STATUS
             WHERE TERM_GROUP_ID = #{termGroupId}
               AND TERM_ID = #{termId}
             ORDER BY CONNECT_FLAG DESC, START_DATE DESC, START_TIME DESC
        ) WHERE ROWNUM = 1
    </select>

</mapper>
