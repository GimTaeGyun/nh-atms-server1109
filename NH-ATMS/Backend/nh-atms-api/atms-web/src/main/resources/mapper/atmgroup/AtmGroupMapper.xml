<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="kr.co.nh.atms.web.atmgroup.mapper.AtmGroupMapper">

    <resultMap id="rm" type="kr.co.nh.atms.web.atmgroup.entity.AtmGroup" autoMapping="true"/>

    <sql id="cols">TERM_GROUP_ID, TERM_GROUP_NAME, GROUP_LEVEL, PARENT_ID, SUPER_ID</sql>

    <sql id="where">
        <where>
            <if test="termGroupId != null and termGroupId != ''">AND TERM_GROUP_ID LIKE '%' || #{termGroupId} || '%'</if>
            <if test="termGroupName != null and termGroupName != ''">AND TERM_GROUP_NAME LIKE '%' || #{termGroupName} || '%'</if>
            <if test="parentId != null and parentId != ''">AND PARENT_ID = #{parentId}</if>
        </where>
    </sql>

    <select id="selectList" resultMap="rm">
        SELECT <include refid="cols"/> FROM T_ATM_GROUP
        <include refid="where"/>
        ORDER BY GROUP_LEVEL, TERM_GROUP_ID
        OFFSET #{offset} ROWS FETCH NEXT #{limit} ROWS ONLY
    </select>

    <select id="countList" resultType="long">SELECT COUNT(*) FROM T_ATM_GROUP <include refid="where"/></select>

    <select id="selectOne" resultMap="rm">
        SELECT <include refid="cols"/> FROM T_ATM_GROUP WHERE TERM_GROUP_ID = #{termGroupId}
    </select>

    <insert id="insert" parameterType="kr.co.nh.atms.web.atmgroup.entity.AtmGroup">
        INSERT INTO T_ATM_GROUP (TERM_GROUP_ID, TERM_GROUP_NAME, GROUP_LEVEL, PARENT_ID, SUPER_ID)
        VALUES (#{termGroupId}, #{termGroupName}, #{groupLevel}, #{parentId}, #{superId})
    </insert>

    <update id="update" parameterType="kr.co.nh.atms.web.atmgroup.entity.AtmGroup">
        UPDATE T_ATM_GROUP
        <set>
            <if test="termGroupName != null">TERM_GROUP_NAME = #{termGroupName},</if>
            <if test="groupLevel != null">GROUP_LEVEL = #{groupLevel},</if>
            <if test="parentId != null">PARENT_ID = #{parentId},</if>
            <if test="superId != null">SUPER_ID = #{superId},</if>
        </set>
        WHERE TERM_GROUP_ID = #{termGroupId}
    </update>

    <delete id="delete">DELETE FROM T_ATM_GROUP WHERE TERM_GROUP_ID = #{termGroupId}</delete>
</mapper>
