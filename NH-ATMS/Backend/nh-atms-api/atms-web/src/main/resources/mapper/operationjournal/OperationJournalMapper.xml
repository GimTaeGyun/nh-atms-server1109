<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="kr.co.nh.atms.web.operationjournal.mapper.OperationJournalMapper">

    <resultMap id="rm" type="kr.co.nh.atms.web.operationjournal.entity.OperationJournal" autoMapping="true"/>

    <sql id="cols">
        TERM_GROUP_ID, TERM_ID, JNL_DATE, JNL_TIME,
        OPERATION_CD, OPERATION_ACTION
    </sql>

    <sql id="where">
        <where>
            <if test="termGroupId != null and termGroupId != ''">
                AND TERM_GROUP_ID = #{termGroupId}
            </if>
            <if test="termId != null and termId != ''">
                AND TERM_ID = #{termId}
            </if>
            <if test="operationCd != null and operationCd != ''">
                AND OPERATION_CD = #{operationCd}
            </if>
            <if test="keyword != null and keyword != ''">
                AND OPERATION_ACTION LIKE '%' || #{keyword} || '%'
            </if>
            <if test="fromDate != null and fromDate != ''">
                AND JNL_DATE &gt;= #{fromDate}
            </if>
            <if test="toDate != null and toDate != ''">
                AND JNL_DATE &lt;= #{toDate}
            </if>
        </where>
    </sql>

    <select id="selectList" resultMap="rm">
        SELECT <include refid="cols"/>
          FROM T_OPERATION_JOURNAL
        <include refid="where"/>
        ORDER BY JNL_DATE DESC, JNL_TIME DESC
        OFFSET #{offset} ROWS FETCH NEXT #{limit} ROWS ONLY
    </select>

    <select id="countList" resultType="long">
        SELECT COUNT(*) FROM T_OPERATION_JOURNAL
        <include refid="where"/>
    </select>

    <select id="selectOne" resultMap="rm">
        SELECT <include refid="cols"/>
          FROM T_OPERATION_JOURNAL
         WHERE TERM_GROUP_ID = #{termGroupId}
           AND TERM_ID       = #{termId}
           AND JNL_DATE      = #{jnlDate}
           AND JNL_TIME      = #{jnlTime}
    </select>

</mapper>
