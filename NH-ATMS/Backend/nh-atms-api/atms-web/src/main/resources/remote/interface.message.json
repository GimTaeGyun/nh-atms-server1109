/*
MIF (Message Interface) : 원격명령 인터페이스
- charset : cp949(ms949), euc-kr
- ##async## : 비동기 처리 여부
*/
{
	 "#charset#" : "euc-kr"

	,"#mif#" : {
		 "#head#": {
			 "#desc#" : "원격명령 헤더"
			,"#type#" : "fixed"
			,"#field#": [
				 { "#key#": "len"   , "#len#": 5, "#dt#": 1          } //길이       | len 제외한 길이 | 00015-99999
				,{ "#key#": "txcode", "#len#": 2, "#body-key#": true } //업무구분   |
				,{ "#key#": "trcode", "#len#": 2                     } //기능구분   |
				,{ "#key#": "seqno" , "#len#": 1                     } //현재시퀀스 | 0-9
				,{ "#key#": "maxseq", "#len#": 1                     } //최종시퀀스 | 0-9
				,{ "#key#": "respcd", "#len#": 1                     } //결과 코드  | (주1)A(비동기 방식)
				,{ "#key#": "filler", "#len#": 8                     } //예비       |
			]
			/*
				※ 참고
				json -> byte[] 변경시 head.field.len 선택사항
				
				(주1) 신규스펙 비동기 처리 요청
				-처리 전 즉시 응답 해더만 전송
				-처리 후 비동기 원격명령 처리 URL로 응답전문 전송
				 : 요청 데이터부 마지막에 async_uid를 HTTP 헤더에 추가하여 전송 async_uid
			*/
		}
		,"#body#": {
			 "00" : {}

			,"10": {
				 "#desc#" : "Agent Open : agent -> ap"
				,"#type#" : "delim"
				,"#sep#"  : "|"
				,"#field#": [
					{ "#key#": "atm_id", "#len#" : 7, "#req#" : 0, "#res#" : 1 }
				]
				/*
					Agent Open Message는 ATM AP 와의 세션 생성 후 Remote Control 실행 및 Poll을 통한
					모니터링의 준비완료를 확인하는 message이다.

					ATM ID : ATM의 Unique한 ID (영업점코드+단말번호)
				*/
			}

			,"11": {
				 "#desc#" : "Atm Polling : agent -> ap"
				,"#type#" : "delim"
				,"#sep#"  : "|"
				,"#field#": [
					{ "#key#": "atm_status", "#len#" : 1, "#req#" : 0, "#res#" : 1}
				]
				/*
					Polling Message는 AP와의 세션이 정상인지 확인하는 Message로, 일정 주기로 전달된다.
				*/
			}

			,"12": {
				 "#desc#" : "ATM Status 조회 : agent -> ap"
				,"#type#" : "delim"
				,"#sep#"  : "|"
				,"#field#": [
					 { "#key#": "atm_status", "#len#" :  2, "#req#" : 0, "#res#" : 1 }
					,{ "#key#": "err_code"  , "#len#" : 10, "#req#" : 0, "#res#" : 1 }
				]
				/*
					ATM의 Status정보를 조회하는 기능으로 status정보의 내용은 Appendix를 참조한다.
				*/
			}

			,"14": {
				 "#desc#" : "화상/화면 이미지 촬영  : agent -> ap"
				,"#type#" : "delim"
				,"#sep#"  : "|"
				,"#field#": [
					 { "#key#": "scr_kind", "#len#" : 1, "#req#" : 1, "#res#" : 0 } //화면구분   | 1:화상,2:현재화면
					,{ "#key#": "img_path", "#len#" : 0, "#req#" : 0, "#res#" : 1 } //이미지경로 | 파일명포함
				]
				/*
					현재 자동화기기 앞에 있는 고객의 화상이미지를 촬영한다. 장애, 고객대기 상태일 경우에만 실행한다.

					-Default 이미지 경로 
						: 화상 - “c:\MoniManager\Image\Custormer_YYYYMMDDHHMMSS.JPG”
						: 화면 - “c:\MoniManager\Image\screen_YYYYMMDDHHMMSS.JPG”
					-ATM AP에서 위 경로로 저장하지 못할 경우 별도의 이미지 경로를 송신함.

					[확인필요사항]
					c:\MoniManager\Image << 하드코딩인가?
				*/
			}

			,"16": {
				 "#desc#" : "개별/일괄 다운로드 : agent -> ap (에이전트 파일 다운로드 완료 후 ap 통보)"
				,"#type#" : "delim"
				,"#sep#"  : "|"
				,"#field#": [
					 { "#key#": "dl_kind", "#len#" : 1, "#req#" : 1, "#res#" : 0 } //다운로드구분      | 1:개별(AP통보), 2:일괄(AP통보), 3:복사(AP통보없음)
					,{ "#key#": "fl_type", "#len#" : 1, "#req#" : 1, "#res#" : 0 } //파일형식          | (주1)
					,{ "#key#": "dl_path", "#len#" : 0, "#req#" : 1, "#res#" : 0 } //다운로드 파일경로 | 파일명포함 (주2)
					,{ "#key#": "dl_vers", "#len#" : 0, "#req#" : 1, "#res#" : 0 } //다운로드 버전     |

					//atms -> ag 로 다운로드 요청시 필요한 필드 추가
					,{ "#key#": "cp_path", "#len#" : 0, "#req#" : 1, "#res#" : 0 } //다운로드 받은 파일을 복사할 로컬폴더경로
				]
				,"##async##": true
				/*
					[TOBE]
					(주1)
					1: ap  : ap
					2: ag  : agent      // 25.04.08 미사용 확정
					3: ad  : 광고(상단) // 25.04.08 미사용 확정
					4: cs  : 광고(고객) // 25.04.08 미사용 확정
					9: etc : 그 외      // 25.04.08 미사용 확정

					(주2) dl_path : 서버의 파일 상대경로, ap 통보전 cp_path로 변경

					[ASIS] 코드표 참조
					MoniManager의 서버로부터 파일 다운로드 완료 후 ATM AP에게 대상 파일의 정보를 알려준다.
					이때 ATM의 응답 Message의 결과코드는 의미가 없으므로 Space로 채운다.

					1) AP는 실행화일명이 포함된 다운로드 경로명을 수신하면 AP 스스로 실행여부를 결정하여 처리한다.
						 수신 후 실행여부와 상관없이 정상 응답을 한다.
					2) 다운로드 파일실행하기 전에 이미 파일은 해당 디렉토리에 다운로드 되어있다
					3) 사양은 AP 다운로드 완료 전문으로 사용하므로 데이터부를 참조하지 않는다.
					4) Download File은 ~\agent\tmp 폴더에 임시로 저장하며, 다운로드 완료시에는
						 다운로드 대상 폴더로 이동한다. 만약 다운로드시나 파일 이동시에 문제가 발생할 경우에는 삭제처리한다.
				*/
			}

			,"17": {
				 "#desc#" : "파일 수집 : atms -> ag -> atms -> web service call"
				,"#type#" : "delim"
				,"#sep#"  : "|"
				,"#field#": [
					 { "#key#": "fl_type"  , "#len#" : 2, "#req#" : 1, "#res#" : 1 } //파일형식 | 코드표 참조 (주1)
					,{ "#key#": "fl_info"  , "#len#" : 8, "#req#" : 2, "#res#" : 1 } //날짜시간 | yyyymmdd or 'folder'
					,{ "#key#": "fl_path"  , "#len#" : 0, "#req#" : 0, "#res#" : 1 } //파일경로 |
					,{ "#key#": "fl_comp"  , "#len#" : 1, "#req#" : 1, "#res#" : 1 } //압출여부 | asis 0:비압축, 1:zip , tobe 항상압축
					,{ "#key#": "fl_csum"  , "#len#" : 1, "#req#" : 0, "#res#" : 1 } //Checksum | 0
					,{ "#key#": "fl_size"  , "#len#" : 0, "#req#" : 0, "#res#" : 1 } //파일크기 |

					//업로드한 서버 파일패스
					,{ "#key#": "serv_path", "#len#" : 0, "#req#" : 0, "#res#" : 1 }
				]
				,"##async##": true
				/*
					[TOBE]
					(주1)
					"FILE TYPE" : {
						 "11": "AP Program"                // 미사용
						,"12": "Agent Program"             // 미사용
						,"13": "AP Log"                    // ap 처리
						,"14": "Agent Log"                 // ag 처리, fl_info : 일자
						,"15": "Agent ini"                 // ag 처리, 
						,"16": "Journal Index"             // ag 처리, fl_info : 일자
						,"17": "Journal Data"              // ag 처리, fl_info : 일자
						,"18": "Journal Image"             // ag 처리, fl_info : 일자
						,"19": "Windows Event Log"         // 미사용
						,"20": "Selected File or Folder"   // ag 처리, fl_info : folder = fl_path is folder
						,"21": "공과금수납기 Log"          // 확인중....
					} 

					[ASIS]
					MoniManager Agent는 ATM AP에 업로드 파일 type등 정보를 알려주고 ATM AP는 파일수집
					대상파일의 정보를 응답하기 전에 해당파일을 작성하여 응답 후 MoniManager Agent가 서버
					에 Upload할 수 있도록 한다. 이때 ATM의 응답 Message의 결과코드로 0x00이외의 값을 리
					턴 할 경우 upload를 실행하지 않는다.

					1) File Information : AP Log, Agent Log, Journal Index, Journal Data, Journal Image의 경우에
						 File의 날짜 정보를 YYYYMMDD 형태로 송신한다.
					2) 압축여부 : Agent에서의 압축여부에 따라서 AP에서 대상 화일을 Zip 형식으로 압축하여
						 파일을 생성한 후에 파일명을 응답한다. 만약 비압축으로 요청할 경우에 대상화일이 압
						 축되었을 경우에는 압축여부에 “1”로 세팅하여 Zip이라고 응답한다.
					3) AP에서는 AP Log만 파일 수집 할 수 있도록 한다. (나머지는 Agent 처리)
				*/
			}

			,"18": {
				 "#desc#" : "인근점포 지도파일 다운로드(미사용) : ap -> agent -> atms -> agent -> ap"
				,"#type#" : "delim"
				,"#sep#"  : "|"
				,"#field#": [
					 { "#key#": "brn_cd"  , "#len#" : 5, "#req#" : 1, "#res#" : 0 } //영업점코드   |
					,{ "#key#": "cnr_cd"  , "#len#" : 2, "#req#" : 1, "#res#" : 0 } //코너코드     |
					,{ "#key#": "map_path", "#len#" : 0, "#req#" : 0, "#res#" : 1 } //지도파일경로 |
				]
				/*
					ATM 장애시 표시된 인근점포리스트 중 하나의 코너명를 선택하면, 서버로부터
					인근점포 지도파일을 다운로드 하고 AP는 해당 지도를 화면에 표시한다.
					표시영역은 지도영역과 주소영역을 분리하여 표시한다.

					■ 지도파일 표시 흐름 (실시간 지도파일 다운로드)
					- AP는 선택된 인근코너의 영업점코드(5), 코너코드(2)를 에이전트로 전송한다.
					- 에이전트는 해당 코너정보를 서버로 전송한다.
					- 서버는 해당 지도파일을 다운로드한다.
					- 에이전트는 해당 지도파일의 경로를 AP를 전달한다.
					- AP는 해당 경로의 지도파일과 주소를 화면에 표시한다
				*/
			}

			,"20": {
				 "#desc#" : "Device Reset : agent -> ap"
				,"#type#" : "delim"
				,"#sep#"  : "|"
				,"#field#": []
				/*
					ATM의 Device에 대한 Reset 명령을 수행한다. 장애상태일 경우에만 수행한다.
				*/
			}

			,"21": {
				 "#desc#" : "Reboot : agent -> ap"
				,"#type#" : "delim"
				,"#sep#"  : "|"
				,"#field#": []
				/*
					ATM을 Reboot한다. ATM AP는 응답 Message를 리턴 하고 Reboot를 실행한다.
					거래 중이거나 계원모드인 경우는 실행하지 않는다.
				*/
			}

			,"22": {
				 "#desc#" : "Power Off : agent -> ap"
				,"#type#" : "delim"
				,"#sep#"  : "|"
				,"#field#": []
				/*
					ATM을 Reboot한다. ATM AP는 응답 Message를 리턴 하고 Reboot를 실행한다.
					거래 중이거나 계원모드인 경우는 실행하지 않는다.
				*/
			}

			,"23": {
				 "#desc#" : "중지 (Out of Service) : agent -> ap"
				,"#type#" : "delim"
				,"#sep#"  : "|"
				,"#field#": []
				/*
					ATM의 고객서비스를 중지한다. 반드시 거래대기 중 상태에서만 실행한다.
					그 밖의 경우는 실패 리턴 한다.
				*/
			}

			,"24": {
				 "#desc#" : "운영 (In Service)  : agent -> ap"
				,"#type#" : "delim"
				,"#sep#"  : "|"
				,"#field#": []
				/*
					운영중지 상태인 ATM의 고객서비스를 재개한다. 반드시 운영중지 상태에서만 실행한다.
					그 밖의 경우는 실패 리턴 한다.
				*/
			}

			,"25": {
				 "#desc#" : "ATM 저널운영모드변경 : agent -> ap"
				,"#type#" : "delim"
				,"#sep#"  : "|"
				,"#field#": [
					{ "#key#": "jnl_mode", "#len#" : 1, "#req#" : 1, "#res#" : 0 } //요청 저널 Mode |
				]
				/*
					ATM에서 사용하는 저널의 운영모드를 변경하기 위한 원격기능임.
					1) 요청한 Journal Mode로 변경되었을 경우에는 MoniManager.ini에 JNLmode에 현재의 모드를 기록한다.
					2) 요청한 Journal Mode로 변경하지 못한 경우에는 현재 모드를 기록 및 응답하며, 실패결과를 보낸다.
					3) Journal Mode
						 0 : None (운영중지)
						 1 : E-journal (Electronic Journal만 운영함)
						 2 : EJ + Paper (Electronic Journal과 Paper저널을 동시에 사용함)
						 3: Paper (종이저널만 사용)
				*/
			}

			,"26": {
				 "#desc#" : "ATM 저널운영모드변경통보 : ap -> agent"
				,"#type#" : "delim"
				,"#sep#"  : "|"
				,"#res#" : false
				,"#field#": [
					{ "#key#": "jnl_mode", "#len#" : 1, "#req#" : 1, "#res#" : 0 } //요청 저널 Mode |
				]
				/*
					ATM에서 전자저널 또는 종이저널의 운영상태가 HDD가 Full이 되거나 오류로 인하여
					전자저널을 운영모드가 변경되었음을 알린다.
					추가) Agent가 로그인시에 서버로부터 저널모드를 변경하기 위한 정보를 수신하여 ATM에 전달하면,
								저널변경 송신하는 방식대로 처리한다.
								- 저널변경 요청시 변경된 저널모드를 INI에 Write한 후에 변경된 모드를 송신한다.
					1) Journal Mode
						 0 : None (운영중지)
						 1 : E-journal (Electronic Journal만 운영함)
						 2 : EJ + Paper (Electronic Journal과 Paper저널을 동시에 사용함)
						 3: Paper (종이저널만 사용)

					Agent -> AP 응답전문 없음.  ????
				*/
			}

			,"27": {
				 "#desc#" : "메시지 전송 : agent -> ap"
				,"#type#" : "delim"
				,"#sep#"  : "|"
				,"#field#": [
					 { "#key#": "show_sec", "#len#" : 0, "#req#" : 1, "#res#" : 0 } //표시 시간(초) |
					,{ "#key#": "show_msg", "#len#" : 0, "#req#" : 1, "#res#" : 0 } //표시 메시지   |
				]
				/*
					ATM의 화면에 Message를 표시할 목적으로 메시지를 전송한다.
					1) ATM AP가 화면에 안내 Message를 표시한다.
					2) AP는 수신 받은 표시시간 만큼 Message를 표시하며, 시간 초과시에 이전 화면으로 복귀한다.
						 단, 표시시간이 O일 경우에는 계속 표시한다.
					3) ATM이 장애이거나 중지(폐국)상태일 경우에만 표시한다.
					4) 표시문자 최대 길이는 40byte 5줄을 기준으로 한다. (각 줄은 줄바꿈 구분자 포함)
				*/
			}

			,"28": {
				 "#desc#" : "직접 명령실행 : agent -> ap"
				,"#type#" : "delim"
				,"#sep#"  : "|"
				,"#field#": [
					{ "#key#": "cmd", "#len#" : 0, "#req#" : 1, "#res#" : 0 } // 실행명령 |
				]
				,"##async##": true
				/*
					자동화기기 AP에게 경로와 파일명등을 전달하여 해당파일을 실행하도록 한다.
					자동화기기 복구를 위해 자동화기기 내 특정 파일을 실행한다.
					(AP/AGENT 실행주체 구분 필요)
					단, 실행파일은 BM Guard에 등록되어 있어야 한다.
				*/
			}

			,"29": {
				 "#desc#" : "일반 다운로드 : agent -> ap"
				,"#type#" : "delim"
				,"#sep#"  : "|"
				,"#field#": [
					 //다운로드 완료할 파일을 복사할 파일정보 files : downloads = 1 : 1
					 { "#key#": "files"             , "#len#" :  1, "#dt#": 1 // 파일개수
						,"#field#" : [
							 { "#key#": "path"      , "#len#" :  0          } // 파일경로
						]
					}
					,{ "#key#": "cmd"               , "#len#" :  0          } // 실행명령

					//다운로드 할 서버 파일정보
