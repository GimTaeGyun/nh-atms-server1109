# =====================================================================
# .dockerignore — Docker 빌드 컨텍스트에서 제외할 파일 목록
#
# 원리: docker build 명령 실행 시 Docker 데몬으로 전송되는 파일(빌드 컨텍스트)에서
#       아래 항목들을 제외한다.
#       → 빌드 컨텍스트 크기 축소 → docker build 속도 향상
# =====================================================================

# 로컬 설치된 패키지 (컨테이너 안에서 npm ci로 새로 설치하므로 불필요)
# 크기: 수백 MB ~ 1GB
node_modules/

# Vite 빌드 결과물 (컨테이너 안에서 npm run build로 새로 생성)
dist/

# Git 이력 (빌드와 무관)
.git/
.gitignore

# 로컬 환경 파일 (보안 정보 포함 가능)
.env.local
.env.*.local

# IDE 설정 파일
.idea/
.vscode/
*.iml

# 개발 서버 캐시
.vite/

# 문서
*.md
